<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guitardsp.ui.controller.MainController">
   <children>
      <BorderPane prefHeight="500.0" prefWidth="800.0">
         <center>
            <StackPane fx:id="boardArea" style="-fx-background-color: #99533c;" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="boardHint" mouseTransparent="true" text="Drag pedals here from the list on the right" style="-fx-text-fill: #e8c9b8; -fx-font-size: 16px;" />
                  <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;">
                     <content>
                        <HBox fx:id="boardBox" alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 20;" />
                     </content>
                  </ScrollPane>
               </children>
            </StackPane>
         </center>
         <top>
            <AnchorPane prefHeight="48.0" prefWidth="800.0" style="-fx-background-color: #1f0801;" BorderPane.alignment="CENTER">
               <children>
                  <Button contentDisplay="GRAPHIC_ONLY" layoutX="14.0" layoutY="1.0" mnemonicParsing="false" onAction="#settings" prefHeight="37.0" prefWidth="81.0" style="-fx-background-color: transparent;">
                     <graphic>
                        <ImageView fitHeight="38.0" fitWidth="76.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/settings.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <HBox alignment="CENTER_RIGHT" spacing="8.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="9.0">
                     <children>
                        <Label text="Master" style="-fx-text-fill: white;" />
                        <Slider fx:id="masterSlider" max="150.0" min="0.0" prefWidth="160.0" value="100.0" />
                        <Label fx:id="masterLabel" minWidth="40.0" text="100%" style="-fx-text-fill: #e8c9b8;" />
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
         </top>
         <right>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="170.0" style="-fx-background: #701e03; -fx-background-color: #701e03;" BorderPane.alignment="CENTER">
               <content>
                  <VBox fx:id="paletteBox" spacing="10.0" style="-fx-padding: 12;">
                     <children>
                        <Label text="Pedals" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </right>
      </BorderPane>

      <!-- Settings overlay: darkens everything behind it and shows the panel in the middle -->
      <StackPane fx:id="settingsOverlay" visible="false" style="-fx-background-color: rgba(0,0,0,0.6);">
         <children>
            <VBox maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="420.0" spacing="12.0" style="-fx-background-color: #2b1008; -fx-background-radius: 12; -fx-padding: 24;">
               <children>
                  <Label text="Settings" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />
                  <Label text="Input device" style="-fx-text-fill: white;" />
                  <ComboBox fx:id="inputBox" maxWidth="1.7976931348623157E308" />
                  <Label text="Instrument input (channel)" style="-fx-text-fill: white;" />
                  <ComboBox fx:id="channelBox" maxWidth="1.7976931348623157E308" />
                  <Label text="Output device" style="-fx-text-fill: white;" />
                  <ComboBox fx:id="outputBox" maxWidth="1.7976931348623157E308" />
                  <Label fx:id="bufferLabel" text="Buffer" style="-fx-text-fill: white;" />
                  <Slider fx:id="bufferSlider" blockIncrement="1.0" majorTickUnit="1.0" max="11.0" min="6.0" minorTickCount="0" showTickMarks="true" snapToTicks="true" value="8.0" />
                  <Label text="Smaller = lower latency, but may crackle. Larger = more stable." style="-fx-text-fill: #cccccc; -fx-font-size: 11px;" />
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#closeSettings" text="Cancel" />
                        <Button defaultButton="true" mnemonicParsing="false" onAction="#applySettings" text="Apply" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</StackPane>
